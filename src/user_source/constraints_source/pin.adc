# 阶段D：SW3/C6 选择 KEY3 调亮度(0)或对比度(1)。课件口径 SW1/SW2 为官方占用，SW3/SW4 空闲。
set_pin_assignment { contrast_sw } { LOCATION = C6; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
# 10/26：SW4/C5（10/24 删缩略图后空闲）拨上=1：大厅屏底行显示当前图片的原始分辨率和显示尺寸。
set_pin_assignment { res_sw } { LOCATION = C5; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
# 10/28：SW2/C7（手册第 18 页，此前未用）拨上=1：显示音频柱形图。
set_pin_assignment { wave_sw } { LOCATION = C7; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
# 第14讲：KEY3=B1，低电平按下；KEY2/B2 与 KEY4/C1 绑定保持原状。
set_pin_assignment { key3 } { LOCATION = B1; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }

# V6：陶晶驰 TJC8048X270 触摸屏串口，J1 第 39/40 脚（手册 J1 表 GPIOA_34/GPIOA_35）。屏独立 5V 供电，共地。
set_pin_assignment { tjc_rx } { LOCATION = T15; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { tjc_tx } { LOCATION = R14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
# V7-2 板间链路：J2 第 1/2 脚（J2 的 36 个 IO 此前全部空闲）。接线：本板 link_tx -> 对板 link_rx，
# 本板 link_rx <- 对板 link_tx，另接一根 GND（J2 第 12 或 30 脚）。单板自检时把这两脚用跳线短接。
set_pin_assignment { link_tx } { LOCATION = P4; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { link_rx } { LOCATION = N4; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

# V8 板载网口（RTL8211E，RGMII，按 100 Mbps 使用），引脚见开发板手册“以太网接口”表。
# 网口芯片的复位/配置脚不接 FPGA，上电后由 eth_phy_ctrl 经 MDIO 扫描地址并配置。
set_pin_assignment { eth_txc } { LOCATION = T12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { eth_tx_ctl } { LOCATION = T7; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { eth_txd[0] } { LOCATION = T4; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { eth_txd[1] } { LOCATION = T6; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { eth_txd[2] } { LOCATION = M7; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { eth_txd[3] } { LOCATION = T8; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
# RXC 在 T14（GCLKIOT_3，全局时钟输入脚）。
set_pin_assignment { eth_rxc } { LOCATION = T14; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { eth_rx_ctl } { LOCATION = T13; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { eth_rxd[0] } { LOCATION = P6; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { eth_rxd[1] } { LOCATION = M6; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { eth_rxd[2] } { LOCATION = T9; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { eth_rxd[3] } { LOCATION = N9; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { eth_mdc } { LOCATION = L13; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { eth_mdio } { LOCATION = M13; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }

# SW1 verified free in both formal projects; HX4S20 manual p18: C8, up=1.
set_pin_assignment { volume_sw } { LOCATION = C8; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
